---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <span class="legal">© <span id="copyright-year">{year}</span> Lorenz Beglinger</span>
    <a href="/#top"><img src="/logo-mark.png" alt="" class="mark" /></a>
    <span class="links">
      <a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a>
    </span>
  </div>
</footer>

<script>
  const el = document.getElementById("copyright-year");
  if (el) el.textContent = String(new Date().getFullYear());
</script>

<style>
  .site-footer {
    background: var(--bg-dark);
    padding: 38px 0 60px;
    border-top: 1px solid var(--line-on-dark);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .legal,
  .links {
    font: 300 13px/1 var(--font-sans);
    color: var(--text-cream-faint);
  }

  .links a:hover {
    color: var(--text-cream-dim);
  }

  .mark {
    height: 38px;
    width: auto;
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-top: 24px;
      padding-bottom: 28px;
    }

    .inner {
      flex-direction: column;
      text-align: center;
      gap: 18px;
    }

    .mark {
      order: 1;
    }

    .legal {
      order: 2;
    }

    .links {
      order: 3;
    }
  }
</style>
