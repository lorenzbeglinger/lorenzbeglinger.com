---
const navLinks = [
  { href: "/#programme", label: "Programm" },
  { href: "/#ueber-mich", label: "Über mich" },
];

const mobileLinks = [...navLinks, { href: "/#anfrage", label: "Anfragen" }];
---

<header class="site-header" data-header>
  <div class="header-bg">
    <div class="bar container">
      <a href="/#top" class="brand" aria-label="Lorenz Beglinger — Startseite">
        <img src="/logo-full.png" alt="Lorenz Beglinger" class="brand-full" />
      </a>

      <nav class="nav-desktop" aria-label="Hauptnavigation">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/#anfrage" class="btn-outline">Anfragen</a>
      </nav>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Menü öffnen</span>
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <img
      src="/uploads/LB-Hero.jpg"
      alt=""
      class="mobile-menu-bg"
      aria-hidden="true"
    />
    <div class="mobile-menu-head container">
      <a href="/#top" class="mobile-menu-brand" aria-label="Lorenz Beglinger — Startseite" data-menu-link>
        <img src="/logo-full.png" alt="Lorenz Beglinger" />
      </a>
      <button
        type="button"
        class="menu-close"
        aria-label="Menü schliessen"
        data-menu-close
      >
        <span class="close-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
    <nav aria-label="Mobile Navigation">
      {mobileLinks.map((l) => <a href={l.href} data-menu-link>{l.label}</a>)}
    </nav>
    <div class="mobile-menu-foot">
      <a href="/#anfrage" class="btn mobile-cta" data-menu-link>Jetzt anfragen</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const header = document.querySelector<HTMLElement>("[data-header]");

  function closeMenu() {
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.removeAttribute("tabindex");
    menu?.classList.remove("is-open");
    header?.classList.remove("menu-open");
    document.body.classList.remove("no-scroll");
  }

  function openMenu() {
    toggle?.setAttribute("aria-expanded", "true");
    toggle?.setAttribute("tabindex", "-1");
    menu?.classList.add("is-open");
    header?.classList.add("menu-open");
    document.body.classList.add("no-scroll");
    closeBtn?.focus();
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener("click", closeMenu);

  menu?.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((a) => {
    a.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }

  .header-bg {
    background: linear-gradient(
      180deg,
      rgba(11, 11, 14, 0.92) 0%,
      rgba(11, 11, 14, 0.55) 70%,
      rgba(11, 11, 14, 0) 100%
    );
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .menu-open .header-bg {
    background: rgba(11, 11, 14, 0.98);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 26px;
    padding-bottom: 26px;
  }

  .brand {
    display: block;
    flex: none;
    line-height: 0;
  }

  .brand-full {
    height: 40px;
    width: auto;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 34px;
    white-space: nowrap;
    font: 400 14px/1 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-cream-dim);
  }

  .nav-desktop a:not(.btn-outline):hover {
    color: var(--text-cream);
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    padding: 10px;
    margin: -10px;
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 24px;
  }

  .menu-icon span {
    display: block;
    height: 1px;
    width: 24px;
    background: var(--gold);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-open .menu-icon span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-open .menu-icon span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 900px) {
    .bar {
      padding-top: 20px;
      padding-bottom: 20px;
    }

    .brand-full {
      height: 34px;
    }

    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .mobile-menu {
      display: block;
      position: fixed;
      inset: 0;
      top: 0;
      overflow: hidden;
      background: radial-gradient(
        120% 95% at 72% 20%,
        #3a3a3f 0%,
        #1d1d23 45%,
        #0b0b0e 100%
      );
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .mobile-menu.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-menu-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 78%;
      object-fit: cover;
      object-position: 60% 6%;
      opacity: 0.18;
      filter: saturate(0.4);
      -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
    }

    .mobile-menu-head {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 20px;
      padding-bottom: 20px;
    }

    .mobile-menu-brand {
      display: block;
      line-height: 0;
    }

    .mobile-menu-brand img {
      display: block;
      height: 34px;
      width: auto;
    }

    .menu-close {
      position: relative;
      width: 34px;
      height: 34px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      padding: 0;
    }

    .close-icon span {
      position: absolute;
      width: 24px;
      height: 1px;
      background: var(--gold);
    }

    .close-icon span:first-child {
      transform: rotate(45deg);
    }

    .close-icon span:last-child {
      transform: rotate(-45deg);
    }

    .mobile-menu nav {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 30px var(--edge) 0;
    }

    .mobile-menu nav a:not(.btn) {
      font: 300 34px/1.1 var(--font-serif);
      color: var(--text-cream);
      padding: 22px 0;
      border-bottom: 1px solid var(--line-on-dark-faint);
    }

    .mobile-menu-foot {
      position: relative;
      padding: 30px var(--edge) 0;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .mobile-cta {
      width: 100%;
    }
  }
</style>
