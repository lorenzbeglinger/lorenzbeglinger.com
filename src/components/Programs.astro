---
const programs = [
  {
    badge: "Familie",
    title: "Magie am Tisch",
    img: "/uploads/magie-am-tisch.jpg",
    imgAlt: "Kartenkunststück am Tisch",
    imgPosition: "50% 62%",
    text: "Ich komme an deinem Familienfest direkt an den Tisch, mitten ins Geschehen. Karten und Münzen — alles passiert direkt vor den Augen der Gäste und oft in ihren eigenen Händen.",
    duration: "30 Min.",
    guests: "10 – 25 Gäste",
    price: "CHF 59",
  },
  {
    badge: "Kinder",
    title: "Die Kindershow",
    img: "/uploads/kindershow.jpg",
    imgAlt: "Kinder an einem Geburtstagsfest",
    imgPosition: "50% 45%",
    text: "Eine halbe Stunde, in der die Kinder die Hauptrolle spielen. Sie helfen mir beim zaubern — und die Erwachsenen staunen und lachen mindestens genauso viel dabei.",
    duration: "45 Min.",
    guests: "10 – 25 Gäste (ab 7 Jahren)",
    price: "CHF 79",
  },
];
---

<section class="programs" id="programme">
  <div class="container">
    <h2>Mein Programm</h2>
    <p class="intro">
      Ich zaubere seit ich zehn Jahre alt bin und trete mit meinem Programm
      vor allem an Kindergeburtstagen und Familienfesten auf.
    </p>
    <div class="grid">
      {
        programs.map((p) => (
          <article class="card">
            <img
              src={p.img}
              alt={p.imgAlt}
              loading="lazy"
              style={`object-position:${p.imgPosition}`}
            />
            <div class="card-body">
              <p class="badge">{p.badge}</p>
              <h3>{p.title}</h3>
              <p class="text">{p.text}</p>
              <div class="meta">
                <span>{p.duration}</span>
                <span>{p.guests}</span>
                <span class="price">{p.price}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .programs {
    padding: clamp(70px, 10vw, 110px) 0;
    background: var(--bg-dark);
    border-top: 1px solid var(--border-gold-strong);
  }

  h2 {
    margin: 0 0 22px;
    font: 300 clamp(2.25rem, 1.6rem + 2vw, 3.25rem) / 1.1 var(--font-serif);
    color: var(--text-cream);
  }

  .intro {
    margin: 0 0 clamp(32px, 5vw, 56px);
    max-width: 620px;
    font: 300 18px/1.7 var(--font-sans);
    color: var(--text-cream-dim);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border-gold);
  }

  .card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
  }

  .card-body {
    padding: 38px 36px 42px;
  }

  .badge {
    margin: 0 0 16px;
    font: 400 11px/1 var(--font-sans);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
  }

  h3 {
    margin: 0 0 14px;
    font: 400 32px/1.2 var(--font-serif);
    color: var(--text-cream);
  }

  .text {
    margin: 0 0 26px;
    font: 300 16px/1.75 var(--font-sans);
    color: var(--text-cream-dim);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    font: 300 14px/1 var(--font-sans);
    color: var(--text-cream-faint);
    padding-top: 22px;
    border-top: 1px solid var(--line-on-dark-faint);
  }

  .price {
    font: 400 12px/1 var(--font-sans);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .card-body {
      padding: 24px 22px 28px;
    }

    .card img {
      height: 200px;
    }

    h3 {
      font: 400 26px/1.2 var(--font-serif);
    }
  }
</style>
