<div class="cookie-banner" data-cookie-banner hidden role="dialog" aria-label="Cookie-Hinweis" aria-describedby="cookie-text">
  <p class="title">Diese Website verwendet Cookies.</p>
  <p id="cookie-text" class="text">
    Ich nutze Cookies, um die Nutzung der Website zu analysieren. Mehr dazu in
    der <a href="/datenschutz">Datenschutzerklärung</a>.
  </p>
  <div class="actions">
    <button type="button" class="btn btn-accept" data-cookie-accept>
      Akzeptieren
    </button>
    <button type="button" class="btn-reject" data-cookie-reject>
      Ablehnen
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = "lb-cookie-consent";
  const banner = document.querySelector<HTMLElement>("[data-cookie-banner]");

  function hasDecided() {
    try {
      return Boolean(localStorage.getItem(STORAGE_KEY));
    } catch {
      return true;
    }
  }

  function reserveSpace() {
    if (!banner) return;
    const space = banner.offsetHeight + 24;
    document.documentElement.style.setProperty("--cookie-banner-space", `${space}px`);
    document.body.classList.add("has-cookie-banner");
  }

  function releaseSpace() {
    document.body.classList.remove("has-cookie-banner");
  }

  function decide(value: "accepted" | "rejected") {
    try {
      localStorage.setItem(STORAGE_KEY, value);
    } catch {
      /* private browsing: consent simply won't persist across reloads */
    }
    banner?.classList.remove("is-visible");
    releaseSpace();
    window.setTimeout(() => banner?.setAttribute("hidden", ""), 250);
  }

  if (banner && !hasDecided()) {
    window.setTimeout(() => {
      banner.removeAttribute("hidden");
      reserveSpace();
      requestAnimationFrame(() => banner.classList.add("is-visible"));
    }, 600);
    window.addEventListener("resize", () => {
      if (!banner.hasAttribute("hidden")) reserveSpace();
    });
  }

  document
    .querySelector("[data-cookie-accept]")
    ?.addEventListener("click", () => decide("accepted"));
  document
    .querySelector("[data-cookie-reject]")
    ?.addEventListener("click", () => decide("rejected"));
</script>

<style>
  .cookie-banner {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 80;
    width: 340px;
    background: var(--bg-card);
    border: 1px solid var(--border-gold-strong);
    padding: 26px 24px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .cookie-banner.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .title {
    margin: 0 0 10px;
    font: 400 15px/1.5 var(--font-sans);
    color: var(--text-cream);
  }

  .text {
    margin: 0 0 20px;
    font: 300 14px/1.65 var(--font-sans);
    color: var(--text-cream-dim);
  }

  .text a {
    text-decoration: underline;
  }

  .actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .actions .btn {
    padding: 14px 22px;
    font-size: 14px;
  }

  .btn-reject {
    border: 1px solid var(--line-on-dark);
    background: transparent;
    color: var(--text-cream-dim);
    font: 400 14px/1 var(--font-sans);
    padding: 14px 22px;
    border-radius: 2px;
  }

  .btn-reject:hover {
    color: var(--text-cream);
  }

  @media (max-width: 640px) {
    .cookie-banner {
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      border-left: none;
      border-right: none;
      border-bottom: none;
      box-shadow: 0 -12px 30px rgba(0, 0, 0, 0.45);
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
